# Copy to .env. These are the DEV values; prod's .env (in ~/apps/breakthrough) uses
#   COMPOSE_PROJECT_NAME=breakthrough  BREAKTHROUGH_PORT=8190
#   BREAKTHROUGH_DATA_DIR=/data/apps/breakthrough
#   PUBLIC_URL=https://breakthrough.grlab.co.uk  (see inventory.md)
COMPOSE_PROJECT_NAME=breakthrough-dev
BREAKTHROUGH_PORT=8195
BREAKTHROUGH_DATA_DIR=./data
# Where promote.sh keeps database snapshots (prod only).
BREAKTHROUGH_BACKUP_DIR=/data/backups/breakthrough

# Public base URL of this instance (builds the SSO redirect URI <PUBLIC_URL>/auth/callback).
PUBLIC_URL=
# If set, the header shows a "← Horizon" link back to the portal.
PORTAL_URL=
# Set when behind the reverse proxy, e.g. TRUST_PROXY=1 (Express "trust proxy").
TRUST_PROXY=

# Login standard (horizon-infra design §2). Ignored by the dev auth stub.
AUTH_LOCAL=on
AUTH_SSO=off
SSO_ISSUER=https://tig-sso.grlab.co.uk/realms/tig
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_ADMIN_GROUP=
SESSION_DAYS=7
